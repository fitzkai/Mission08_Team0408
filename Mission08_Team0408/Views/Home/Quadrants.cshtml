
@model List<ToDo>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quadrant View</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        /* Basic styling to divide the page into 4 quadrants */
        .quadrant-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            gap: 20px;
            width: 100%;
            height: 100vh;
            padding: 20px;
        }

        .quadrant {
            border: 1px solid #ccc;
            padding: 20px;
            box-sizing: border-box;
            overflow-y: auto;
            position: relative;
        }

        .quadrant-label {
            position: absolute;
            top: 0;
            left: 0;
            font-weight: bold;
            background-color: rgba(255, 255, 255, 0.7);
            padding: 5px;
            font-size: 1.2rem;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        ul {
            list-style-type: none;
            padding: 0;
        }

        li {
            padding: 5px 0;
        }

        .no-tasks {
            color: grey;
            font-style: italic;
        }
    </style>
</head>
<body>

    <div class="container mt-4">
        <div class="row label-row">
            <div class="col-md-6"><h2>Urgent</h2></div>
            <div class="col-md-6"><h2>Not Urgent</h2></div>
        </div>

        <div class="row">
            <div class="col-md-1 side-label"><h2>Important</h2></div>

            <div class="col-md-5 quadrant bg-light">
                <h4>Quadrant 1</h4>
                <button class="btn btn-primary btn-sm mb-2">Add</button>
                <ul class="list-group">
                    @foreach (var record in Model)
                    {
                        if (record.Quadrant == 1)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @record.TaskName
                                <div class="task-buttons">
                                    <a asp-controller="Home" asp-action="Edit" asp-route-id="@record.TaskId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-controller="Home" asp-action="Delete" asp-route-id="@record.TaskId" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="col-md-5 quadrant bg-secondary text-white">
                <h4>Quadrant 2</h4>
                <button class="btn btn-primary btn-sm mb-2">Add</button>
                <ul class="list-group">
                    @foreach (var record in Model)
                    {
                        if (record.Quadrant == 2)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @record.TaskName
                                <div class="task-buttons">
                                    <a asp-controller="Home" asp-action="Edit" asp-route-id="@record.TaskId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-controller="Home" asp-action="Delete" asp-route-id="@record.TaskId" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="col-md-1"></div>
        </div>

        <div class="row mt-2">
            <div class="col-md-1 side-label"><h2>Not Important</h2></div>

            <div class="col-md-5 quadrant bg-info text-white">
                <h4>Quadrant 3</h4>
                <button class="btn btn-primary btn-sm mb-2">Add</button>
                <ul class="list-group">
                    @foreach (var record in Model)
                    {
                        if (record.Quadrant == 3)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @record.TaskName
                                <div class="task-buttons">
                                    <a asp-controller="Home" asp-action="Edit" asp-route-id="@record.TaskId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-controller="Home" asp-action="Delete" asp-route-id="@record.TaskId" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="col-md-5 quadrant bg-warning">
                <h4>Quadrant 4</h4>
                <button class="btn btn-primary btn-sm mb-2">Add</button>
                <ul class="list-group">
                    @foreach (var record in Model)
                    {
                        if (record.Quadrant == 4)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @record.TaskName
                                <div class="task-buttons">
                                    <a asp-controller="Home" asp-action="Edit" asp-route-id="@record.TaskId" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-controller="Home" asp-action="Delete" asp-route-id="@record.TaskId" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="col-md-1"></div>
        </div>
    </div>

</body>
</html>